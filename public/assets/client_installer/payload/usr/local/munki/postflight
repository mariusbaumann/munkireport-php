#!/bin/bash
#
# MunkiReport postflight
# Signals the MunkiReport runner that a munki run has finished

TOUCH_FILE_PATH="/Users/Shared/.com.github.munkireport.run"
LAUNCHD="com.github.munkireport.runner"
LAUNCHD_PATH="/Library/LaunchDaemons/${LAUNCHD}.plist"
SUBMIT_SCRIPT="/usr/local/munkireport/munkireport-runner"

# Refresh the touch file the launch daemon watches
/bin/rm -f "${TOUCH_FILE_PATH}"
/usr/bin/touch "${TOUCH_FILE_PATH}"

if [[ -f "${LAUNCHD_PATH}" ]]; then
	# Load the launchd if it's present on disk but not loaded
	if ! /bin/launchctl list | /usr/bin/grep -q "${LAUNCHD}"; then
		/bin/launchctl load "${LAUNCHD_PATH}"
	fi
else
	# If the launchd isn't present, call the submit script old school
	[[ -x "${SUBMIT_SCRIPT}" ]] && "${SUBMIT_SCRIPT}"
fi

exit 0
